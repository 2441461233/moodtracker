{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_BASE_URL": "", "EXPO_NO_TELEMETRY": "1" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": { "image": "latest" },
      "env": { "EXPO_PUBLIC_BASE_URL": "", "EXPO_NO_TELEMETRY": "1" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6776595613",
        "appleTeamId": "9PB9F396XQ"
      }
    }
  }
}
