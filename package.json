{
  "name": "moodtracker",
  "version": "2.1.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "preview": "node scripts/serve-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts modules/mood-health/tests/*.test.ts",
    "test:web": "node --test tests/web-export.test.mjs",
    "format": "prettier --write App.tsx src tests scripts/*.mjs app.config.js app.json eas.json package.json .github/workflows/*.yml README.md design-qa.md docs modules/mood-health/**/*.ts modules/mood-health/*.json modules/mood-health/*.md",
    "build": "npm run build:web",
    "build:web": "EXPO_PUBLIC_BASE_URL=/moodtracker expo export --platform web && node scripts/prepare-web.mjs",
    "verify": "npm run typecheck && npm test && npm run build:web && npm run test:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/metro-config": {
      "postcss": "8.5.26"
    },
    "ws@^7.5.10": "7.5.13"
  },
  "private": true
}
