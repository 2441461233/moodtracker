{
  "expo": {
    "name": "情绪像素",
    "slug": "moodtracker",
    "version": "2.1.6",
    "description": "一个只属于你的心情空间。记录感受、回看日历、发现生活与情绪的小关联。",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-font",
      "./plugins/with-plain-splash",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5FB",
          "dark": {
            "backgroundColor": "#0B0D18"
          }
        }
      ],
      "./plugins/with-quick-record-widget",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "ios": {
      "scheme": "moodjournal",
      "supportsTablet": true,
      "bundleIdentifier": "com.zhenyu.moodjournal.app",
      "appleTeamId": "9PB9F396XQ",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.zhenyu.moodjournal.app.widgets"],
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "在你开启自动同步并授权后，自动读取 Apple 健康与正念中的心境，按日期显示在日历、每日记录与独立健康回顾中。收到变更或回到 App 时更新，仅在前台内存展示，不加入日记备份。",
        "NSHealthUpdateUsageDescription": "在你开启自动同步并授权后，将近一年的本地心情以及之后新增、修改的心情、时间和对应活动自动写入 Apple 健康。文字日记不会写入。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#6C63DF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/pwa-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "427558a5-13db-42e4-a992-8a5167b5bffe"
      }
    },
    "owner": "zhen2yu"
  }
}
